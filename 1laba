bool isOpen(char c) {
    return c == '(' || c == '{' || c == '[';
}

bool isClose(char c) {
    return c == ')' || c == '}' || c == ']';
}

char bracketPair(char close) {
    if (close == ')') return '(';
    if (close == '}') return '{';
    if (close == ']') return '[';
    return 0;
}

bool checkBrackets(const std::string& s) {
    std::stack<char> st;  

    for (char c : s) {
        if (isOpen(c)) {
 
            st.push(c);
        }
        else if (isClose(c)) {
            if (st.empty()) {
                return false;
            }

            if (st.top() != bracketPair(c)) {
