#include <iostream>   // ввод/вывод: cout, cin
#include <string>      // строки: std::string
#include <stack>       // стек: std::stack
#include <locale>      // локализация: setlocale

// Проверяет, является ли символ открывающей скобкой: (, {, [
bool isOpen(char c) {
    return c == '(' || c == '{' || c == '[';
}

// Проверяет, является ли символ закрывающей скобкой: ), }, ]
bool isClose(char c) {
    return c == ')' || c == '}' || c == ']';
}

// Возвращает парную открывающую скобку для данной закрывающей.
// Если символ не является закрывающей скобкой — возвращает 0 (то же самое, что '\0').
char bracketPair(char c) {
    switch (c) {
    case ')': return '(';
    case '}': return '{';
    case ']': return '[';
    default:  return 0;   // нет пары — возвращаем нулевой код
    }
}

// Основная функция проверки скобочного выражения.
// Возвращает true, если скобки расставлены правильно, иначе false.
bool checkBrackets(const std::string& s) {
    std::stack<char> st;  // стек для хранения открывающих скобок

    // Проходим по каждому символу строки
    for (char c : s) {
        if (isOpen(c)) {
            // Открывающая скобка — кладём в стек
            st.push(c);
        }
        else if (isClose(c)) {
            // Закрывающая скобка

            // Если стек пуст — закрывающей скобке не хватает пары
            if (st.empty()) {
                return false;
            }

            // Сравниваем верхнюю скобку в стеке с ожидаемой парой
            if (st.top() != bracketPair(c)) {
                // Типы скобок не совпадают — ошибка
                return false;
            }

            // Пара найдена — убираем открывающую скобку из стека
            st.pop();
        }
        // Остальные символы игнорируются
    }

    // Если стек пуст, все скобки закрыты корректно
    return st.empty();
}

int main() {
    // Настройка локали для русского текста
    std::setlocale(LC_ALL, "Russian");

    std::string s;
    std::cout << "Введите строку: ";
    std::getline(std::cin, s);  // читаем всю строку целиком

    if (s.empty()) {
        std::cout << "Строка не существует" << std::endl;
        return 0;
    }

    if (checkBrackets(s)) {
        std::cout << "Строка существует" << std::endl;
    }
    else {
        std::cout << "Строка не существует" << std::endl;
    }

    return 0;
}

