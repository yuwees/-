import random


def comb_sort(arr):
    n = len(arr)
    gap = n
    shrink = 1.247
    swapped = True

    while gap > 1 or swapped:
        gap = int(gap / shrink)
        if gap < 1:
            gap = 1

        swapped = False
        for i in range(n - gap):
            if arr[i] > arr[i + gap]:
                arr[i], arr[i + gap] = arr[i + gap], arr[i]
                swapped = True

    return arr


def insertion_sort(arr):
    for i in range(1, len(arr)):
        key = arr[i]
        j = i - 1
        while j >= 0 and arr[j] > key:
            arr[j + 1] = arr[j]
            j -= 1
        arr[j + 1] = key

    return arr


def selection_sort(arr):
    n = len(arr)

    for i in range(n - 1):
        min_idx = i
        for j in range(i + 1, n):
            if arr[j] < arr[min_idx]:
                min_idx = j
        arr[i], arr[min_idx] = arr[min_idx], arr[i]

    return arr


def main():
    original = [12, 5, 27, 3, 18, 9, 1, 42, 7, 30, 15, 22]

    print("Исходная последовательность:")
    print(original)

    print("Сортировка методом прочесывания:")
    print(comb_sort(original.copy()))

    print("Сортировка вставками:")
    print(insertion_sort(original.copy()))

    print("Сортировка посредством выбора:")
    print(selection_sort(original.copy()))

    random_arr = [random.randint(-50, 50) for _ in range(20)]
    print("Исходный:      ", random_arr)
    print("Прочесывание:  ", comb_sort(random_arr.copy()))
    print("Вставками:     ", insertion_sort(random_arr.copy()))
    print("Выбором:       ", selection_sort(random_arr.copy()))


if __name__ == "__main__":
    main()