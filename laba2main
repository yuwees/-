import json
from enum import Enum
from typing import Dict, List, Tuple


class Ansi:
    RESET: str = "\033[0m"
    CLEAR: str = "\033[2J"
    HOME: str = "\033[1;1H"
    PREFIX: str = "\033["
    SAVE_CURSOR: str = "\033[s"
    RESTORE_CURSOR: str = "\033[u"
    HIDE_CURSOR: str = "\033[?25l"
    SHOW_CURSOR: str = "\033[?25h"


class Color(Enum):
    BLACK = 30
    RED = 31
    GREEN = 32
    YELLOW = 33
    BLUE = 34
    MAGENTA = 35
    CYAN = 36
    WHITE = 37

    def to_ansi(self) -> str:
        return Ansi.PREFIX + str(self.value) + "m"


class Printer:

    _fonts: Dict[str, Dict[str, List[str]]] = {} #один общий словарь

    def __init__(self, color: Color, position: Tuple[int, int], symbol: str = "*", font_size: str = "5"):
        if not symbol:
            raise ValueError("symbol не может быть пустым")
        self.color = color
        self.position = position
        self.symbol = symbol
        self.font_size = font_size
        self._line_offset = 0
        if not Printer._fonts:
            try:
                with open("fonts.json", "r", encoding="utf-8") as f:
                    Printer._fonts = json.load(f)
            except FileNotFoundError:
                raise RuntimeError("Файл fonts.json не найден рядом с main.py")
        if font_size not in Printer._fonts:
            raise RuntimeError("В fonts.json нет шрифта размера '" + font_size + "'")
        self._font = Printer._fonts[font_size]
        if " " not in self._font:
            raise RuntimeError("В шрифте '" + font_size + "' нет символа пробела")

    def _move(self, x: int, y: int) -> str: #перемещение курсора 
        return Ansi.PREFIX + str(y + 1) + ";" + str(x + 1) + "H"

    def _render(self, text: str) -> List[str]: #текст -> пвсевдошрифт
        height = len(self._font[" "])
        result = ["" for _ in range(height)]
        for ch in text:
            letter = self._font.get(ch.upper(), self._font[" "])
            for i in range(height):
                line = letter[i].replace("*", self.symbol)
                result[i] = result[i] + line + " "
        return result

    def _draw(self, text: str, x: int, y: int) -> None: #текст на экране
        lines = self._render(text)
        for i, line in enumerate(lines):
            out = self._move(x, y + i) + self.color.to_ansi() + line + Ansi.RESET
            print(out, end="", flush=True)

    def newline(self) -> None:
        self._line_offset = self._line_offset + len(self._font[" "]) + 1

    @classmethod
    def print_text(cls, text: str, color: Color, position: Tuple[int, int] = (0, 0), symbol: str = "*", font_size: str = "5") -> None:
        p = Printer(color, position, symbol, font_size)
        p._draw(text, position[0], position[1])

    def print(self, text: str) -> None:
        x, y = self.position
        self._draw(text, x, y + self._line_offset)

    def __enter__(self):
        print(Ansi.SAVE_CURSOR + Ansi.HIDE_CURSOR, end="", flush=True)
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        print(Ansi.RESET + Ansi.SHOW_CURSOR + Ansi.RESTORE_CURSOR, end="", flush=True)
        return False


def clear() -> None:
    print(Ansi.CLEAR + Ansi.HOME, end="", flush=True)


def main() -> None:
    clear()
    print("1. Статический вывод (classmethod):")
    print()
    Printer.print_text("ПРИВЕТ", Color.RED, (2, 3), "*", "5")
    Printer.print_text("МИР", Color.GREEN, (2, 10), "#", "5")
    print()
    input("Enter...")

    clear()
    print("2. Вывод через with:")
    print()
    with Printer(Color.BLUE, (2, 3), "*", "5") as printer:
        printer.print("РАЗ")
        printer.newline()
        printer.print("ДВА")
        printer.newline()
        printer.print("ТРИ")
    print()
    input("Enter...")

    clear()
    print("3. Шрифты высотой 5 и 7:")
    print()
    Printer.print_text("АБВ", Color.MAGENTA, (2, 3), "*", "5")
    Printer.print_text("АБВ", Color.CYAN, (2, 12), "@", "7")
    print()
    input("Enter...")


if __name__ == "__main__":
    main()